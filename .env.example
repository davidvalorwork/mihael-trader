# Copia este archivo a .env y llena los valores reales. .env NUNCA se commitea (ver .gitignore).

# Token del bot de Telegram — se obtiene hablando con @BotFather en Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# chat_id del ÚNICO usuario autorizado a usar el bot (tu familiar/amigo).
# Para obtenerlo: habla con tu bot una vez, luego visita
# https://api.telegram.org/bot<TU_TOKEN>/getUpdates y busca "chat":{"id": ...}
TELEGRAM_AUTHORIZED_CHAT_ID=
